# Model provider: "bedrock" (default, AWS creds), "anthropic", or "ollama" (local/private)
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# Only needed when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514
# Only needed when MODEL_PROVIDER=ollama (e.g. a local Hermes model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_ID=hermes3

# TickTick mirror (optional): scheduler-lane tasks are pushed to TickTick.
# Either a raw token, or a path to an OAuth token JSON file with {"access_token": ...}
TICKTICK_ACCESS_TOKEN=
TICKTICK_TOKEN_FILE=

# Telegram push channel (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///offload.db
