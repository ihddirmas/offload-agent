# Model provider: "bedrock" (default, uses AWS credentials) or "anthropic"
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# Only needed when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514

# Telegram push channel (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///offload.db
